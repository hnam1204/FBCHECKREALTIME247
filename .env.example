# Server Configuration
PORT=3000
HOST=0.0.0.0

# Security (AES-256-GCM 32-byte hex key for encrypting OAuth tokens)
ENCRYPTION_MASTER_KEY=e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855

# Database
DB_PATH=./data/monitor.db

# Monitoring Scheduler Configuration
DEFAULT_CHECK_INTERVAL_SEC=60
MAX_CONCURRENT_CHECKS=5
RETRY_MAX_ATTEMPTS=3
RETRY_BACKOFF_BASE_SEC=15

# Meta Graph API (Optional for direct production sync)
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v21.0

# Developer Simulation Mode (Generates realistic, labeled simulated updates for URLs without tokens)
ENABLE_DEV_SIMULATOR=true
